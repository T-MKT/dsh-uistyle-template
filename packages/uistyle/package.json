{
  "name": "@tak1208/dsh-uistyle-template",
  "version": "0.1.0",
  "description": "Typed design-token surface plus the layout compositions the DSH web UI lacks (Card, Page, Toolbar, Panel, Stack, SectionHeader)",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ui",
    "design-tokens",
    "css-variables",
    "react",
    "layout",
    "components"
  ],
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-MKT/dsh-uistyle-template.git",
    "directory": "packages/uistyle"
  },
  "homepage": "https://github.com/T-MKT/dsh-uistyle-template#readme",
  "bugs": {
    "url": "https://github.com/T-MKT/dsh-uistyle-template/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "tokens": "node tools/extract-tokens.mjs && node tools/build-reference.mjs && node tools/gen-types.mjs",
    "bundle": "rm -rf lib && tsdown && tsc -p tsconfig.build.json",
    "build": "pnpm run tokens && pnpm run bundle",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p tsconfig.json --noEmit",
    "verify": "bash tools/verify-types.sh"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.9.3"
  }
}
